# Lokal: pglite:./.data/db (eingebaute Datenbank, kein Postgres nötig). Railway: postgres://… (wird automatisch gesetzt)
DATABASE_URL=pglite:./.data/db
# Öffentliche Adresse der App (für Webhook, Login-Redirect und Klick-Links)
APP_URL=http://localhost:3000
# Dein Dashboard-Passwort
ADMIN_PASSWORD=
# Zufallswerte: openssl rand -hex 32
SESSION_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=
WEBHOOK_VERIFY_TOKEN=
# Aus dem Meta-Dashboard (Instagram-App-ID und Instagram-App-Geheimcode)
IG_APP_ID=
IG_APP_SECRET=
GRAPH_VERSION=v26.0
